  <script>
    const container = document.getElementById('fields-container');
    const addBtn = document.getElementById('add-field');
    let fieldCount = 0;

    addBtn.addEventListener('click', () => {
      fieldCount++;
      const div = document.createElement('div');
      div.className = 'field-row';
      const fieldName = 'field_' + fieldCount;
      div.innerHTML = `
        <input type="text" class="field-label" placeholder="Текст вопроса (например: ФИО)" required>
        <input type="hidden" class="field-name" value="${fieldName}">
        <select class="field-type">
          <option value="text">Короткий текст</option>
          <option value="textarea">Длинный текст</option>
        </select>
        <label style="white-space:nowrap;"><input type="checkbox" class="field-required" checked> Обязательный</label>
        <button type="button" class="btn-small" onclick="this.parentElement.remove()">Удалить</button>
      `;
      container.appendChild(div);
    });

    document.getElementById('form-builder').addEventListener('submit', (e) => {
      const schema = [];
      const rows = document.querySelectorAll('.field-row');
      
      rows.forEach((row) => {
        schema.push({
          name: row.querySelector('.field-name').value,
          label: row.querySelector('.field-label').value,
          type: row.querySelector('.field-type').value,
          required: row.querySelector('.field-required').checked
        });
      });

      if (schema.length === 0) {
        e.preventDefault();
        alert('Добавьте хотя бы один вопрос!');
        return;
      }

      document.getElementById('schema_json').value = JSON.stringify(schema);
    });
  </script>