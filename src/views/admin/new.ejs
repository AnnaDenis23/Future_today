<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Создать форму</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <div class="container">
    <a href="/admin">← Назад</a>
    <h1>Новая форма</h1>
    
    <form id="form-builder" action="/admin/forms" method="POST">
      <label>Название формы (например, Летняя стажировка)</label>
      <input type="text" name="title" required placeholder="Введите название">
      
      <h3>Вопросы</h3>
      <div id="fields-container"></div>
      
      <button type="button" id="add-field" class="btn btn-secondary">+ Добавить вопрос</button>
      
      <!-- Скрытое поле для отправки JSON со структурой -->
      <input type="hidden" name="schema_json" id="schema_json">
      
      <hr style="margin: 20px 0;">
      <button type="submit" class="btn btn-primary">Сохранить форму</button>
    </form>
  </div>

  <script>
    const container = document.getElementById('fields-container');
    const addBtn = document.getElementById('add-field');
    let fieldCount = 0;

    addBtn.addEventListener('click', () => {
      fieldCount++;
      const div = document.createElement('div');
      div.className = 'field-row';
      div.innerHTML = `
        <input type="text" class="field-label" placeholder="Текст вопроса" required>
        <select class="field-type">
          <option value="text">Короткий текст</option>
          <option value="textarea">Длинный текст</option>
        </select>
        <label><input type="checkbox" class="field-required" checked> Обязательный</label>
        <button type="button" onclick="this.parentElement.remove()">Удалить</button>
      `;
      container.appendChild(div);
    });

    document.getElementById('form-builder').addEventListener('submit', (e) => {
      const schema = [];
      const rows = document.querySelectorAll('.field-row');
      
      rows.forEach((row, index) => {
        schema.push({
          name: 'q_' + index,
          label: row.querySelector('.field-label').value,
          type: row.querySelector('.field-type').value,
          required: row.querySelector('.field-required').checked
        });
      });

      document.getElementById('schema_json').value = JSON.stringify(schema);
    });
  </script>
</body>
</html>