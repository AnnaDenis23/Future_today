<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Админка</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
  <div class="container">
    <h1>Управление формами</h1>
    <a href="/admin/forms/new" class="btn btn-primary">+ Создать форму</a>
    
    <table>
      <thead>
        <tr>
          <th>Название</th>
          <th>Статус</th>
          <th>Действия</th>
        </tr>
      </thead>
      <tbody>
        <% forms.forEach(form => { %>
          <tr>
            <td><%= form.title %></td>
            <td>
              <span class="status <%= form.published ? 'active' : 'draft' %>">
                <%= form.published ? 'Опубликована' : 'Черновик' %>
              </span>
            </td>
            <td class="actions">
              <% if (form.published) { %>
                <a href="/apply/<%= form.slug %>" target="_blank">Открыть ссылку</a>
              <% } %>
              <form action="/admin/forms/<%= form.id %>/publish" method="POST" style="display:inline;">
                <button type="submit" class="btn-small">
                  <%= form.published ? 'Снять с публикации' : 'Опубликовать' %>
                </button>
              </form>
              <a href="/admin/forms/<%= form.id %>/responses">Отклики</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>